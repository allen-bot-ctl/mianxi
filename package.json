{
  "name": "mian-xi",
  "version": "0.1.0",
  "private": true,
  "description": "面戏 · 抖音小游戏「吼退扑扑」本地脚手架（Canvas 2D + TypeScript）",
  "homepage": "https://allen-bot-ctl.github.io/mianxi/",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "demo:typecheck": "tsc -p demo/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
