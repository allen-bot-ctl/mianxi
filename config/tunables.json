    "defaultPeak": 0.6,
    "minDelta": 0.15,
    "baseWindowMs": 1000,
    "peakWindowMs": 1500,
    "peakPercentile": 0.9,
    "_comment": "defaultBase/defaultPeak 是脚手架占位初值，不是算法结论；第 0 周探针把 r_raw 数值交回策划后，由策划修改这里。"
  },
  "slow": {
    "detectHzThreshold": 10,
    "timeScale": 1.3,
